# Copy to .env.local and enter local values. Never commit credentials.
# GitHub authentication is local only; it is not a deployment runtime secret.
GITHUB_ACCESS_TOKEN=

# Existing local names; deployment secret aliases are documented in
# docs/cloudflare-deployment.md. Use an existing scoped API token.
Account_ID=
API_Key=
Access_key_id=
Secret_access_key=
S3_API_endpoint=
