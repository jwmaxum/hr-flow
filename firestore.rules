rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/UserProfile/$(uid); }
    function companyPath(id) { return /databases/$(database)/documents/companies/$(id); }
    function profile() { return get(profilePath(request.auth.uid)).data; }
    function activeIdentityData(p) {
      let authTime = request.auth.token.get('auth_time', 0);
      return p.get('status', 'ACTIVE') == 'ACTIVE' &&
        p.get('mustChangePassword', false) != true &&
        (p.get('sessionValidAfter', 0) == 0 ||
          (authTime is number && authTime >= p.sessionValidAfter));
    }
    function activeCompany(id) {
      return id is string && id != '' && exists(companyPath(id)) && get(companyPath(id)).data.status == 'ACTIVE';
    }
    function entitledCompanyData(c) {
      return c.status == 'ACTIVE' && c.get('accessUntil', null) is timestamp && c.accessUntil > request.time;
    }
    function entitledCompany(id) {
      return id is string && id != '' && exists(companyPath(id)) && entitledCompanyData(get(companyPath(id)).data);
    }
    function isSuperAdminProfile(p) {
      return p.role == 'SUPER_ADMIN' && p.companyId == 'PLATFORM';
    }
    function superAdminProfile(p) {
      return activeIdentityData(p) && isSuperAdminProfile(p);
    }
    function readyProfile(p) {
      return activeIdentityData(p) && (isSuperAdminProfile(p) ||
        (p.role in ['ADMIN', 'SUB_ADMIN', 'MEMBER'] && entitledCompany(p.companyId)));
    }
    function sameCompanyProfile(p, id) {
      return readyProfile(p) && id is string && id != '' && p.companyId == id;
    }
    function companyAdminProfile(p, id) {
      return sameCompanyProfile(p, id) && p.role == 'ADMIN';
    }
    function companyManagerProfile(p, id) {
      return sameCompanyProfile(p, id) && p.role in ['ADMIN', 'SUB_ADMIN'];
    }
    function superAdmin() {
      return signedIn() && exists(profilePath(request.auth.uid)) && superAdminProfile(profile());
    }
    function ready() {
      return signedIn() && exists(profilePath(request.auth.uid)) && readyProfile(profile());
    }
    function sameCompany(id) {
      return signedIn() && exists(profilePath(request.auth.uid)) && sameCompanyProfile(profile(), id);
    }
    function companyAdmin(id) {
      return signedIn() && exists(profilePath(request.auth.uid)) && companyAdminProfile(profile(), id);
    }
    function companyManager(id) {
      return signedIn() && exists(profilePath(request.auth.uid)) && companyManagerProfile(profile(), id);
    }
    function owner(id, uid) { return exists(companyPath(id)) && get(companyPath(id)).data.adminUid == uid; }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function immutableTenant() { return unchanged(['companyId', 'tenantId']); }
    function validTenant(data) {
      return data.companyId is string && data.companyId != '' && data.get('tenantId', data.companyId) == data.companyId;
    }
    function validAttachmentFilename(name) {
      return name is string && name.size() > 0 && name != '.' &&
        !name.matches('.*[.][.].*') && name.matches('[^[:cntrl:]\\\\]+');
    }
    function validAttachmentPath(data, category) {
      let attachment = data.get('attachmentPath', '');
      let parts = attachment is string ? attachment.split('/') : [];
      let length = category == 'notices' ? 4 : 5;
      return attachment is string && (attachment == '' ||
        (attachment.size() <= 1024 && parts.size() == length &&
          parts[0] == 'companies' && parts[1] == data.companyId && parts[2] == category &&
          (category == 'notices' || parts[3] == data.userId) && validAttachmentFilename(parts[length - 1])));
    }
    function validAttachmentInput(data, category) {
      return data.get('attachmentUrl', '') == '' && validAttachmentPath(data, category);
    }
    function validAttachmentUpdate(category) {
      // Existing legacy references remain editable without permitting a new URL
      // or replacing a private path with another tenant/category/owner's object.
      return (request.resource.data.get('attachmentUrl', '') == '' || unchanged(['attachmentUrl'])) &&
        (validAttachmentPath(request.resource.data, category) || unchanged(['attachmentPath']));
    }
    function legacyPayroll(data) {
      // New detailed approvals are created only by the authenticated server.
      // Keep the old deployed client's aggregate-only history operations.
      return data.get('schemaVersion', 1) == 1 &&
        !data.keys().hasAny(['rows', 'sums', 'scope', 'taxTable', 'approvedAtIso', 'revision']);
    }
    function validOptionalSubject(data) {
      return !('userId' in data) || (data.userId is string && data.userId != '' &&
        exists(profilePath(data.userId)) && get(profilePath(data.userId)).data.companyId == data.companyId);
    }
    function validProfileName() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) ||
        (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100);
    }
    function validEmploymentInsuranceIncluded() {
      return unchanged(['employmentInsuranceIncluded']) ||
        request.resource.data.get('employmentInsuranceIncluded', true) is bool;
    }
    function validDivision(id, divisionId) {
      return divisionId is string && (divisionId == '' ||
        (exists(/databases/$(database)/documents/divisions/$(divisionId)) &&
          get(/databases/$(database)/documents/divisions/$(divisionId)).data.companyId == id));
    }
    function validTeamData(t, id, divisionId) {
      return t.companyId == id && t.divisionId == divisionId;
    }
    function validOrg(id, teamId, divisionId) {
      return validDivision(id, divisionId) && teamId is string && (teamId == '' ||
        (exists(/databases/$(database)/documents/teams/$(teamId)) &&
          validTeamData(get(/databases/$(database)/documents/teams/$(teamId)).data, id, divisionId)));
    }
    function validHeadData(h, id) {
      return h.companyId == id && h.get('status', 'ACTIVE') == 'ACTIVE' &&
        h.role in ['ADMIN', 'SUB_ADMIN', 'MEMBER'];
    }
    function validHead(id, uid) {
      return uid is string && (uid == '' || (exists(profilePath(uid)) && validHeadData(get(profilePath(uid)).data, id)));
    }
    function validProfileOrg(data) { return validTenant(data) && validOrg(data.companyId, data.get('teamId', ''), data.get('divisionId', '')); }
    function validOwnRouteProfile(p, data) {
      return data.get('teamId', '') == p.get('teamId', '') &&
        data.get('divisionId', '') == p.get('divisionId', '') && validProfileOrg(data);
    }
    function validOwnRoute(data) {
      return validOwnRouteProfile(profile(), data);
    }
    function validApprovalReady(p) {
      let divId = p.get('divisionId', '');
      return onlyChanged(['status', 'updatedAt', 'updatedBy']) && validProfileOrg(resource.data) &&
        request.resource.data.status in ['PENDING', 'SUB_APPROVED', 'APPROVED', 'REJECTED'] &&
        (isSuperAdminProfile(p) ||
          (p.companyId == resource.data.companyId && (p.role == 'ADMIN' ||
            (p.role == 'SUB_ADMIN' && divId != '' &&
              divId == resource.data.get('divisionId', '') &&
              resource.data.status == 'PENDING' && request.resource.data.status in ['SUB_APPROVED', 'REJECTED']))));
    }
    function validApprovalProfile(p) {
      return readyProfile(p) && validApprovalReady(p);
    }
    function validApproval() {
      return signedIn() && exists(profilePath(request.auth.uid)) && validApprovalProfile(profile());
    }
    function profileSecurityUnchanged() {
      return unchanged(['uid', 'email', 'companyId', 'tenantId', 'status', 'createdAt', 'mustChangePassword',
        'lastPasswordChange', 'sessionValidAfter', 'authVersion', 'securityVersion', 'passwordChangedAt']);
    }
    function canReadCompanyProfile(p, id) {
      return activeIdentityData(p) && (isSuperAdminProfile(p) || (p.companyId == id && activeCompany(id)));
    }
    function canReadCompany(id) {
      return signedIn() && exists(profilePath(request.auth.uid)) && canReadCompanyProfile(profile(), id);
    }
    function canUpdateCompanyProfile(p, id) {
      return activeIdentityData(p) && (
        (isSuperAdminProfile(p) && resource.data.status in ['ACTIVE', 'SUSPENDED'] &&
          request.resource.data.status in ['ACTIVE', 'SUSPENDED'] &&
          onlyChanged(['nameKo', 'nameEn', 'status', 'updatedAt', 'updatedBy', 'lastBackupAt'])) ||
        (p.role == 'ADMIN' && id is string && id != '' && p.companyId == id && entitledCompany(p.companyId) &&
          onlyChanged(['updatedAt', 'updatedBy', 'lastBackupAt']))
      );
    }
    function canUpdateCompany(id) {
      return signedIn() && exists(profilePath(request.auth.uid)) && canUpdateCompanyProfile(profile(), id);
    }
    function canReadUserProfileWith(p, uid) {
      return readyProfile(p) && (
        request.auth.uid == uid ||
        isSuperAdminProfile(p) ||
        (p.role == 'ADMIN' && resource.data.companyId is string && resource.data.companyId != '' &&
          p.companyId == resource.data.companyId)
      );
    }
    function canReadUserProfile(uid) {
      return signedIn() && exists(profilePath(request.auth.uid)) && canReadUserProfileWith(profile(), uid);
    }
    function canUpdateUserProfileWith(p, uid) {
      return readyProfile(p) && profileSecurityUnchanged() && validProfileName() && validEmploymentInsuranceIncluded() && (
        (request.auth.uid == uid && onlyChanged(['name'])) ||
        (request.auth.uid == uid && p.role == 'ADMIN' && onlyChanged([
          'name', 'joinDate', 'annualLeaveTotal', 'usedLeave', 'annualSalary', 'salaryType',
          'isSeveranceIncluded', 'dependents', 'childrenUnder20', 'nonTaxable', 'additionalLeave',
          'teamId', 'divisionId', 'teamHistory', 'rrn', 'address', 'phone', 'personalEmail',
          'bonus', 'withholdingTaxRate', 'employmentInsuranceIncluded'
        ]) && validProfileOrg(request.resource.data)) ||
        ((isSuperAdminProfile(p) ||
          (request.auth.uid != uid && p.role == 'ADMIN' &&
            resource.data.companyId is string && resource.data.companyId != '' &&
            p.companyId == resource.data.companyId)) &&
          onlyChanged(['name', 'role', 'joinDate', 'annualLeaveTotal', 'usedLeave',
            'annualSalary', 'salaryType', 'isSeveranceIncluded', 'dependents', 'childrenUnder20',
            'nonTaxable', 'additionalLeave', 'teamId', 'divisionId', 'teamHistory',
            'rrn', 'address', 'phone', 'personalEmail',
            'bonus', 'withholdingTaxRate', 'employmentInsuranceIncluded']) &&
          resource.data.role != 'SUPER_ADMIN' && request.resource.data.role in ['ADMIN', 'SUB_ADMIN', 'MEMBER'] &&
          validProfileOrg(request.resource.data) &&
          (!owner(resource.data.companyId, uid) || unchanged(['role', 'status'])))
      );
    }
    function canUpdateUserProfile(uid) {
      return signedIn() && exists(profilePath(request.auth.uid)) && canUpdateUserProfileWith(profile(), uid);
    }
    function canReadScopedRecordProfile(p) {
      let data = resource.data;
      let divId = data.get('divisionId', '');
      return readyProfile(p) && (
        isSuperAdminProfile(p) ||
        (data.companyId is string && data.companyId != '' && p.companyId == data.companyId && (
          p.role == 'ADMIN' ||
          (p.role == 'SUB_ADMIN' && divId is string && divId != '' && p.get('divisionId', '') == divId) ||
          data.userId == request.auth.uid
        ))
      );
    }
    function canReadScopedRecord() {
      return signedIn() && exists(profilePath(request.auth.uid)) && canReadScopedRecordProfile(profile());
    }
    function canDeleteScopedRecordProfile(p) {
      let data = resource.data;
      return readyProfile(p) && (
        isSuperAdminProfile(p) ||
        (data.companyId is string && data.companyId != '' && p.companyId == data.companyId && (
          p.role == 'ADMIN' ||
          (data.userId == request.auth.uid && data.status == 'PENDING')
        ))
      );
    }
    function canDeleteScopedRecord() {
      return signedIn() && exists(profilePath(request.auth.uid)) && canDeleteScopedRecordProfile(profile());
    }
    function canUpdateExpenseProfile(p) {
      let data = resource.data;
      return readyProfile(p) && (
        (data.companyId is string && data.companyId != '' && p.companyId == data.companyId &&
          data.userId == request.auth.uid && data.status == 'PENDING' &&
          validOwnRouteProfile(p, request.resource.data) && validAttachmentUpdate('expenses') &&
          unchanged(['companyId', 'tenantId', 'userId', 'status', 'createdAt', 'divisionId', 'teamId'])) ||
        validApprovalReady(p)
      );
    }
    function canUpdateExpense() {
      return signedIn() && exists(profilePath(request.auth.uid)) && canUpdateExpenseProfile(profile());
    }
    function canUpdateNoticeProfile(p) {
      let data = resource.data;
      return readyProfile(p) && (
        isSuperAdminProfile(p) ||
        (data.companyId is string && data.companyId != '' && p.companyId == data.companyId && (
          p.role == 'ADMIN' || (p.role == 'SUB_ADMIN' && data.authorId == request.auth.uid)
        ))
      ) && unchanged(['companyId', 'tenantId', 'authorId', 'createdAt']) && validAttachmentUpdate('notices');
    }
    function canUpdateNotice() {
      return signedIn() && exists(profilePath(request.auth.uid)) && canUpdateNoticeProfile(profile());
    }
    function canReadNotificationProfile(p) {
      return sameCompanyProfile(p, resource.data.companyId) && resource.data.recipientRole == p.role;
    }
    function canReadNotification(uid) {
      return signedIn() && uid == request.auth.uid && resource.data.recipientId == uid &&
        exists(profilePath(request.auth.uid)) && canReadNotificationProfile(profile());
    }

    match /companies/{id} {
      // Registration, identity ownership and subscription dates are server-only.
      allow read: if canReadCompany(id);
      allow create, delete: if false;
      allow update: if canUpdateCompany(id);
      // ERP uses authenticated callable services, including quantity-only responses.
      match /{erpCollection}/{recordId} {
        allow read, write: if false;
      }
    }
    match /tenantRegistry/{document=**} { allow read, write: if false; }
    match /divisions/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if (superAdmin() || companyAdmin(request.resource.data.companyId)) &&
        validTenant(request.resource.data) &&
        validHead(request.resource.data.companyId, request.resource.data.get('headId', ''));
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId)) && immutableTenant() &&
        validHead(resource.data.companyId, request.resource.data.get('headId', ''));
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /teams/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if (superAdmin() || companyAdmin(request.resource.data.companyId)) &&
        validTenant(request.resource.data) &&
        request.resource.data.get('divisionId', '') != '' &&
        validDivision(request.resource.data.companyId, request.resource.data.divisionId) &&
        validHead(request.resource.data.companyId, request.resource.data.get('leaderId', ''));
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId)) && immutableTenant() &&
        request.resource.data.get('divisionId', '') != '' &&
        validDivision(resource.data.companyId, request.resource.data.divisionId) &&
        validHead(resource.data.companyId, request.resource.data.get('leaderId', ''));
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /UserProfile/{uid} {
      // SUB_ADMIN uses the server's minimal directory instead of salary/HR documents.
      allow read: if canReadUserProfile(uid);
      allow create, delete: if false;
      allow update: if canUpdateUserProfile(uid);
    }
    match /expenses/{id} {
      allow read: if canReadScopedRecord();
      allow create: if sameCompany(request.resource.data.companyId) && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING' && validOwnRoute(request.resource.data) && validAttachmentInput(request.resource.data, 'expenses');
      allow update: if canUpdateExpense();
      allow delete: if canDeleteScopedRecord();
    }
    match /leaves/{id} {
      allow read: if canReadScopedRecord();
      allow create: if sameCompany(request.resource.data.companyId) && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING' && validOwnRoute(request.resource.data) && validAttachmentInput(request.resource.data, 'leaves');
      allow update: if validApproval();
      allow delete: if canDeleteScopedRecord();
    }
    match /attendance/{id} {
      allow read: if canReadScopedRecord();
      allow create: if sameCompany(request.resource.data.companyId) && request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in ['IN', 'OUT'] && validOwnRoute(request.resource.data);
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId)) &&
        unchanged(['companyId', 'tenantId', 'userId', 'divisionId', 'teamId', 'createdAt']);
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /notices/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if companyManager(request.resource.data.companyId) && request.resource.data.authorId == request.auth.uid &&
        validTenant(request.resource.data) && validAttachmentInput(request.resource.data, 'notices');
      allow update: if canUpdateNotice();
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /AuditLogs/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyManager(request.resource.data.companyId) && validTenant(request.resource.data);
      allow update: if false;
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /config/{id} {
      allow read: if superAdmin() || sameCompany(id);
      allow create: if (superAdmin() || companyAdmin(id)) && request.resource.data.get('companyId', id) == id &&
        request.resource.data.get('tenantId', id) == id;
      allow update: if (superAdmin() || companyAdmin(id)) && immutableTenant();
      allow delete: if superAdmin();
    }
    match /system_config/{id} {
      allow read: if ready();
      allow write: if superAdmin();
    }
    match /backup_tasks/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyAdmin(request.resource.data.companyId) && request.resource.data.requestedBy == request.auth.uid && validTenant(request.resource.data);
      allow update: if superAdmin() && unchanged(['companyId', 'tenantId', 'requestedBy', 'createdAt']);
      allow delete: if superAdmin();
    }
    match /payroll_records/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyAdmin(request.resource.data.companyId) && request.resource.data.approvedBy == request.auth.uid &&
        validTenant(request.resource.data) && validOptionalSubject(request.resource.data) && legacyPayroll(request.resource.data);
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId)) &&
        legacyPayroll(resource.data) && legacyPayroll(request.resource.data) && unchanged(['companyId', 'tenantId', 'userId', 'approvedBy', 'createdAt']);
      allow delete: if (superAdmin() || companyAdmin(resource.data.companyId)) && legacyPayroll(resource.data);
      match /revisions/{revision} {
        allow read: if exists(/databases/$(database)/documents/payroll_records/$(id)) &&
          resource.data.recordId == id && resource.data.companyId == get(/databases/$(database)/documents/payroll_records/$(id)).data.companyId &&
          (superAdmin() || companyAdmin(resource.data.companyId));
        allow write: if false;
      }
      match /legacySources/{source} {
        allow read: if exists(/databases/$(database)/documents/payroll_records/$(id)) &&
          resource.data.recordId == id && resource.data.companyId == get(/databases/$(database)/documents/payroll_records/$(id)).data.companyId &&
          (superAdmin() || companyAdmin(resource.data.companyId));
        allow write: if false;
      }
    }
    match /payroll_drafts/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow write: if false;
      match /versions/{version} {
        allow read: if exists(/databases/$(database)/documents/payroll_drafts/$(id)) &&
          resource.data.draftId == id && resource.data.companyId == get(/databases/$(database)/documents/payroll_drafts/$(id)).data.companyId &&
          (superAdmin() || companyAdmin(resource.data.companyId));
        allow write: if false;
      }
      match /baseline/{version} {
        allow read: if exists(/databases/$(database)/documents/payroll_drafts/$(id)) &&
          resource.data.draftId == id && resource.data.companyId == get(/databases/$(database)/documents/payroll_drafts/$(id)).data.companyId &&
          (superAdmin() || companyAdmin(resource.data.companyId));
        allow write: if false;
      }
    }
    match /payment_claims/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if false;
      allow update: if superAdmin() && unchanged(['companyId', 'tenantId', 'adminUid', 'orderId', 'createdAt']);
      allow delete: if superAdmin();
    }
    match /payments/{id} {
      allow read, create, delete: if superAdmin();
      allow update: if superAdmin() && unchanged(['companyId', 'tenantId', 'adminUid', 'userId', 'createdAt']);
    }
    match /officialLetterNotifications/{uid}/items/{id} {
      allow read: if canReadNotification(uid);
      allow write: if false;
    }
    // Future collections, attachments, registry and official data are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
