rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/UserProfile/$(uid); }
    function companyPath(id) { return /databases/$(database)/documents/companies/$(id); }
    function profile() { return get(profilePath(request.auth.uid)).data; }
    function role() { return profile().role; }
    function companyId() { return profile().companyId; }
    function activeIdentity() {
      return signedIn() && exists(profilePath(request.auth.uid)) &&
        profile().get('status', 'ACTIVE') == 'ACTIVE' && profile().get('mustChangePassword', false) != true &&
        (profile().get('sessionValidAfter', 0) == 0 ||
          (request.auth.token.get('auth_time', 0) is number &&
            request.auth.token.get('auth_time', 0) >= profile().sessionValidAfter));
    }
    function activeCompany(id) {
      return id is string && id != '' && exists(companyPath(id)) && get(companyPath(id)).data.status == 'ACTIVE';
    }
    function entitledCompany(id) {
      return activeCompany(id) && get(companyPath(id)).data.get('accessUntil', null) is timestamp &&
        get(companyPath(id)).data.accessUntil > request.time;
    }
    function superAdmin() { return activeIdentity() && role() == 'SUPER_ADMIN' && companyId() == 'PLATFORM'; }
    function ready() {
      return activeIdentity() && ((role() == 'SUPER_ADMIN' && companyId() == 'PLATFORM') ||
        (role() in ['ADMIN', 'SUB_ADMIN', 'MEMBER'] && entitledCompany(companyId())));
    }
    function sameCompany(id) { return ready() && id is string && id != '' && companyId() == id; }
    function companyAdmin(id) { return sameCompany(id) && role() == 'ADMIN'; }
    function companyManager(id) { return sameCompany(id) && role() in ['ADMIN', 'SUB_ADMIN']; }
    function divisionManager(id, divisionId) {
      return sameCompany(id) && role() == 'SUB_ADMIN' && divisionId is string && divisionId != '' &&
        profile().get('divisionId', '') == divisionId;
    }
    function owner(id, uid) { return exists(companyPath(id)) && get(companyPath(id)).data.adminUid == uid; }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function immutableTenant() { return unchanged(['companyId', 'tenantId']); }
    function validTenant(data) {
      return data.companyId is string && data.companyId != '' && data.get('tenantId', data.companyId) == data.companyId;
    }
    function validAttachmentFilename(name) {
      return name is string && name.size() > 0 && name != '.' &&
        !name.matches('.*[.][.].*') && name.matches('[^[:cntrl:]\\\\]+');
    }
    function validAttachmentPath(data, category) {
      let attachment = data.get('attachmentPath', '');
      let parts = attachment is string ? attachment.split('/') : [];
      let length = category == 'notices' ? 4 : 5;
      return attachment is string && (attachment == '' ||
        (attachment.size() <= 1024 && parts.size() == length &&
          parts[0] == 'companies' && parts[1] == data.companyId && parts[2] == category &&
          (category == 'notices' || parts[3] == data.userId) && validAttachmentFilename(parts[length - 1])));
    }
    function validAttachmentInput(data, category) {
      return data.get('attachmentUrl', '') == '' && validAttachmentPath(data, category);
    }
    function validAttachmentUpdate(category) {
      // Existing legacy references remain editable without permitting a new URL
      // or replacing a private path with another tenant/category/owner's object.
      return (request.resource.data.get('attachmentUrl', '') == '' || unchanged(['attachmentUrl'])) &&
        (validAttachmentPath(request.resource.data, category) || unchanged(['attachmentPath']));
    }
    function validOptionalSubject(data) {
      return !('userId' in data) || (data.userId is string && data.userId != '' &&
        exists(profilePath(data.userId)) && get(profilePath(data.userId)).data.companyId == data.companyId);
    }
    function validProfileName() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) ||
        (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100);
    }
    function validDivision(id, divisionId) {
      return divisionId is string && (divisionId == '' ||
        (exists(/databases/$(database)/documents/divisions/$(divisionId)) &&
          get(/databases/$(database)/documents/divisions/$(divisionId)).data.companyId == id));
    }
    function validOrg(id, teamId, divisionId) {
      return validDivision(id, divisionId) && teamId is string && (teamId == '' ||
        (exists(/databases/$(database)/documents/teams/$(teamId)) &&
          get(/databases/$(database)/documents/teams/$(teamId)).data.companyId == id &&
          get(/databases/$(database)/documents/teams/$(teamId)).data.divisionId == divisionId));
    }
    function validHead(id, uid) {
      return uid is string && (uid == '' || (exists(profilePath(uid)) &&
        get(profilePath(uid)).data.companyId == id && get(profilePath(uid)).data.get('status', 'ACTIVE') == 'ACTIVE' &&
        get(profilePath(uid)).data.role in ['ADMIN', 'SUB_ADMIN', 'MEMBER']));
    }
    function validProfileOrg(data) { return validTenant(data) && validOrg(data.companyId, data.get('teamId', ''), data.get('divisionId', '')); }
    function validOwnRoute(data) {
      return data.get('teamId', '') == profile().get('teamId', '') &&
        data.get('divisionId', '') == profile().get('divisionId', '') && validProfileOrg(data);
    }
    function validApproval() {
      return ready() && onlyChanged(['status', 'updatedAt', 'updatedBy']) && validProfileOrg(resource.data) &&
        request.resource.data.status in ['PENDING', 'SUB_APPROVED', 'APPROVED', 'REJECTED'] &&
        ((role() == 'SUPER_ADMIN' && companyId() == 'PLATFORM') ||
          (companyId() == resource.data.companyId && (role() == 'ADMIN' ||
            (role() == 'SUB_ADMIN' && profile().get('divisionId', '') != '' &&
              profile().get('divisionId', '') == resource.data.get('divisionId', '') &&
              resource.data.status == 'PENDING' && request.resource.data.status in ['SUB_APPROVED', 'REJECTED']))));
    }
    function profileSecurityUnchanged() {
      return unchanged(['uid', 'email', 'companyId', 'tenantId', 'status', 'createdAt', 'mustChangePassword',
        'lastPasswordChange', 'sessionValidAfter', 'authVersion', 'securityVersion', 'passwordChangedAt']);
    }

    match /companies/{id} {
      // Registration, identity ownership and subscription dates are server-only.
      allow read: if superAdmin() || (activeIdentity() && companyId() == id && activeCompany(id));
      allow create, delete: if false;
      allow update: if (superAdmin() && resource.data.status in ['ACTIVE', 'SUSPENDED'] &&
        request.resource.data.status in ['ACTIVE', 'SUSPENDED'] &&
        onlyChanged(['nameKo', 'nameEn', 'status', 'updatedAt', 'updatedBy', 'lastBackupAt'])) ||
        (companyAdmin(id) && onlyChanged(['updatedAt', 'updatedBy', 'lastBackupAt']));
    }
    match /tenantRegistry/{document=**} { allow read, write: if false; }
    match /divisions/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if (superAdmin() || companyAdmin(request.resource.data.companyId)) &&
        validTenant(request.resource.data) &&
        validHead(request.resource.data.companyId, request.resource.data.get('headId', ''));
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId)) && immutableTenant() &&
        validHead(resource.data.companyId, request.resource.data.get('headId', ''));
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /teams/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if (superAdmin() || companyAdmin(request.resource.data.companyId)) &&
        validTenant(request.resource.data) &&
        request.resource.data.get('divisionId', '') != '' &&
        validDivision(request.resource.data.companyId, request.resource.data.divisionId) &&
        validHead(request.resource.data.companyId, request.resource.data.get('leaderId', ''));
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId)) && immutableTenant() &&
        request.resource.data.get('divisionId', '') != '' &&
        validDivision(resource.data.companyId, request.resource.data.divisionId) &&
        validHead(resource.data.companyId, request.resource.data.get('leaderId', ''));
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /UserProfile/{uid} {
      // SUB_ADMIN uses the server's minimal directory instead of salary/HR documents.
      allow read: if ready() && (request.auth.uid == uid || superAdmin() || companyAdmin(resource.data.companyId));
      allow create, delete: if false;
      allow update: if ready() && profileSecurityUnchanged() && validProfileName() && (
        (request.auth.uid == uid && onlyChanged(['name'])) ||
        (request.auth.uid == uid && role() == 'ADMIN' && onlyChanged([
          'name', 'joinDate', 'annualLeaveTotal', 'usedLeave', 'annualSalary', 'salaryType',
          'isSeveranceIncluded', 'dependents', 'childrenUnder20', 'nonTaxable', 'additionalLeave',
          'teamId', 'divisionId', 'teamHistory', 'rrn', 'address', 'phone', 'personalEmail'
        ]) && validProfileOrg(request.resource.data)) ||
        ((superAdmin() || (request.auth.uid != uid && companyAdmin(resource.data.companyId))) &&
          onlyChanged(['name', 'role', 'joinDate', 'annualLeaveTotal', 'usedLeave',
            'annualSalary', 'salaryType', 'isSeveranceIncluded', 'dependents', 'childrenUnder20',
            'nonTaxable', 'additionalLeave', 'teamId', 'divisionId', 'teamHistory',
            'rrn', 'address', 'phone', 'personalEmail']) &&
          resource.data.role != 'SUPER_ADMIN' && request.resource.data.role in ['ADMIN', 'SUB_ADMIN', 'MEMBER'] &&
          validProfileOrg(request.resource.data) &&
          (!owner(resource.data.companyId, uid) || unchanged(['role', 'status'])))
      );
    }
    match /expenses/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId) ||
        divisionManager(resource.data.companyId, resource.data.get('divisionId', '')) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid);
      allow create: if sameCompany(request.resource.data.companyId) && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING' && validOwnRoute(request.resource.data) && validAttachmentInput(request.resource.data, 'expenses');
      allow update: if (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid &&
        resource.data.status == 'PENDING' && validOwnRoute(request.resource.data) && validAttachmentUpdate('expenses') &&
        unchanged(['companyId', 'tenantId', 'userId', 'status', 'createdAt', 'divisionId', 'teamId'])) || validApproval();
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid && resource.data.status == 'PENDING');
    }
    match /leaves/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId) ||
        divisionManager(resource.data.companyId, resource.data.get('divisionId', '')) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid);
      allow create: if sameCompany(request.resource.data.companyId) && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING' && validOwnRoute(request.resource.data) && validAttachmentInput(request.resource.data, 'leaves');
      allow update: if validApproval();
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid && resource.data.status == 'PENDING');
    }
    match /attendance/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId) ||
        divisionManager(resource.data.companyId, resource.data.get('divisionId', '')) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid);
      allow create: if sameCompany(request.resource.data.companyId) && request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in ['IN', 'OUT'] && validOwnRoute(request.resource.data);
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId)) &&
        unchanged(['companyId', 'tenantId', 'userId', 'divisionId', 'teamId', 'createdAt']);
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /notices/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if companyManager(request.resource.data.companyId) && request.resource.data.authorId == request.auth.uid &&
        validTenant(request.resource.data) && validAttachmentInput(request.resource.data, 'notices');
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId) ||
        (companyManager(resource.data.companyId) && resource.data.authorId == request.auth.uid)) &&
        unchanged(['companyId', 'tenantId', 'authorId', 'createdAt']) && validAttachmentUpdate('notices');
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /AuditLogs/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyManager(request.resource.data.companyId) && validTenant(request.resource.data);
      allow update: if false;
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /config/{id} {
      allow read: if superAdmin() || sameCompany(id);
      allow create: if (superAdmin() || companyAdmin(id)) && request.resource.data.get('companyId', id) == id &&
        request.resource.data.get('tenantId', id) == id;
      allow update: if (superAdmin() || companyAdmin(id)) && immutableTenant();
      allow delete: if superAdmin();
    }
    match /system_config/{id} {
      allow read: if ready();
      allow write: if superAdmin();
    }
    match /backup_tasks/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyAdmin(request.resource.data.companyId) && request.resource.data.requestedBy == request.auth.uid && validTenant(request.resource.data);
      allow update: if superAdmin() && unchanged(['companyId', 'tenantId', 'requestedBy', 'createdAt']);
      allow delete: if superAdmin();
    }
    match /payroll_records/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyAdmin(request.resource.data.companyId) && request.resource.data.approvedBy == request.auth.uid &&
        validTenant(request.resource.data) && validOptionalSubject(request.resource.data);
      allow update: if (superAdmin() || companyAdmin(resource.data.companyId)) &&
        unchanged(['companyId', 'tenantId', 'userId', 'approvedBy', 'createdAt']);
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }
    match /payment_claims/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if false;
      allow update: if superAdmin() && unchanged(['companyId', 'tenantId', 'adminUid', 'orderId', 'createdAt']);
      allow delete: if superAdmin();
    }
    match /payments/{id} {
      allow read, create, delete: if superAdmin();
      allow update: if superAdmin() && unchanged(['companyId', 'tenantId', 'adminUid', 'userId', 'createdAt']);
    }
    match /officialLetterNotifications/{uid}/items/{id} {
      allow read: if ready() && uid == request.auth.uid && resource.data.recipientId == uid &&
        sameCompany(resource.data.companyId) && resource.data.recipientRole == role();
      allow write: if false;
    }
    // Future collections, attachments, registry and official data are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
