{
  "name": "hr-management-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server:dev": "npm --prefix server run dev",
    "deploy": "npm run client:build && firebase deploy",
    "emulators": "firebase emulators:start",
    "test:official-letters": "node --test --experimental-test-coverage --test-coverage-include=functions/official-letter-*.js --test-coverage-include=functions/drafting-*.js functions/tests/official-letters.test.js functions/tests/drafting.test.js functions/tests/drafting-attachments-integration.test.js functions/tests/drafting-filename.test.js functions/tests/work-reports.test.js",
    "test:members": "node --test --experimental-test-coverage --test-coverage-include=functions/member-service.js functions/tests/members.test.js",
    "test:rules": "node scripts/security-rules.test.mjs",
    "test:security-api": "node --test --experimental-test-coverage --test-coverage-include=functions/*security*.js --test-coverage-include=functions/attachment-service.js --test-coverage-include=functions/payroll-service.js functions/tests/account-security.test.js functions/tests/admin-security.test.js functions/tests/attachment-security.test.js functions/tests/tenant-security-migration.test.js functions/tests/payroll-service.test.js",
    "test:payroll": "node --test --experimental-test-coverage --test-coverage-include=functions/payroll-service.js --test-coverage-include=functions/payroll-report-model.js --test-coverage-include=functions/payroll-pdf.js functions/tests/payroll-service.test.js functions/tests/payroll-reports.test.js",
    "test:auth-state": "node --test scripts/tests/auth-store-security.test.cjs",
    "test:e2e": "node scripts/e2e/run.cjs",
    "test:e2e:safety": "node --test scripts/tests/e2e-safety.test.cjs",
    "test:e2e:boundary": "node scripts/e2e/check-production.cjs"
  },
  "dependencies": {
    "firebase": "^12.12.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.62.1",
    "firebase-tools": "15.34.1"
  }
}
